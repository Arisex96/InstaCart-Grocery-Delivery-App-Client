# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_.

# Base URL of the API. Leave empty in development to use the dev-server proxy
# in vite.config.ts (which forwards /api to VITE_API_PROXY_TARGET).
VITE_API_URL="https://your-backend-url.vercel.app/api"

# Where the dev-server proxy forwards /api requests. Not exposed to the client
# bundle — it is read by vite.config.ts at startup.
VITE_API_PROXY_TARGET="http://localhost:4000"

# Currency symbol shown across the admin and delivery screens. Keep this in
# step with the server's FREE_DELIVERY_THRESHOLD / DELIVERY_FEE, which are
# denominated in the same currency.
VITE_CURRENCY_SYMBOL="$"
